{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyboard Mouse Heatmap",
  "version": "0.1.3",
  "identifier": "com.keyboardmouse.heatmap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keyboard Mouse Heatmap",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MjdCRDA5QTQ2NzI4RUIKUldUcktHZWtDYjBuNmM4U0YzTm92MGZpNXpSRkg3S0lVaUU4ajIybk5sYms2dC93MGVhVnpqR3gK",
      "endpoints": [
        "https://github.com/lsx666xsl/KeyboardMouseHeatmap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
